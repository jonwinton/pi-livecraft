{
  "name": "pi-livecraft",
  "private": true,
  "version": "1.2.0",
  "keywords": [
    "pi-coding-agent",
    "pi",
    "ai-agent",
    "developer-tools",
    "react",
    "vite",
    "typescript",
    "live-reload",
    "web-workbench",
    "session-management",
    "terminal",
    "local-first"
  ],
  "bin": {
    "pi-livecraft": "./bin/pi-livecraft.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --kill-timeout 3000 --names manager,backend,frontend npm:dev:manager npm:dev:backend npm:dev:frontend",
    "start": "npm run build && concurrently --kill-others --kill-timeout 3000 --names manager,backend npm:start:manager npm:start:backend",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:backend": "node --watch server/backend.ts",
    "dev:manager": "node server/manager-supervisor.ts",
    "start:backend": "node server/backend.ts",
    "start:manager": "node server/manager-supervisor.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint .",
    "test": "node --test",
    "eval:documentation-routing": "node --test evals/documentation-routing.ts",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.8",
    "diff": "^9.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-material-icon-theme": "^1.2.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "dprint": "^0.61.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "lint-staged": {
    "*.{ts,tsx,css,html}": "dprint fmt",
    "!(*-lock).json": "dprint fmt"
  },
  "allowScripts": {
    "dprint@0.61.1": true
  }
}
